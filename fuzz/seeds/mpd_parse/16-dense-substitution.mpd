<?xml version="1.0"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT1S">
  <Period><AdaptationSet mimeType="video/mp4">
    <SegmentTemplate timescale="1" duration="1"
      media="$RepresentationID$$RepresentationID$$RepresentationID$$RepresentationID$$RepresentationID$$RepresentationID$$RepresentationID$$RepresentationID$/$Number%64d$-$Time%64d$-$Bandwidth%64d$.m4s"/>
    <Representation id="0123456789012345678901234567890123456789" bandwidth="1"/>
  </AdaptationSet></Period>
</MPD>
