<MPD type="static" mediaPresentationDuration="PT8S">
  <Period id="p1" duration="PT4S"><AdaptationSet mimeType="video/mp4">
    <SegmentTemplate timescale="1" duration="4" media="p1-$Number$.m4s" initialization="p1-init.mp4"/>
    <Representation id="v" bandwidth="1"/></AdaptationSet></Period>
  <Period id="p2" duration="PT4S"><AdaptationSet mimeType="video/mp4">
    <SegmentTemplate timescale="1" duration="2" media="p2-$Number$.m4s" initialization="p2-init.mp4"/>
    <Representation id="v" bandwidth="1"/></AdaptationSet></Period>
</MPD>
